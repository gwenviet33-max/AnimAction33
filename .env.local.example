# --- Admin ---
# Mot de passe d'accès à /admin/login
ADMIN_PASSWORD=dzha-zb34-7hk9

# --- Resend (envoi d'emails du formulaire de contact) ---
# Crée un compte sur https://resend.com et génère une clé
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_TO=contact@animaction33.fr
EMAIL_FROM=AnimAction33 <noreply@animaction33.fr>

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://animaction33.netlify.app
NEXT_PUBLIC_GOOGLE_REVIEW_LINK=https://g.page/r/animaction33/review
NEXT_PUBLIC_WA_NUMBER=33677243675

# --- Firebase Firestore (persistance des bons de réduction en prod) ---
# 1. Crée un projet sur https://console.firebase.google.com/
# 2. Active Firestore (mode natif)
# 3. Project Settings → Service accounts → "Generate new private key"
# 4. Copie les 3 valeurs ci-dessous depuis le JSON téléchargé
# 5. Pour FIREBASE_PRIVATE_KEY, garde les \n littéraux (pas de vrais retours à la ligne)
FIREBASE_PROJECT_ID=animaction33
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@animaction33.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Si Firebase n'est PAS configuré, l'app utilise un fichier .data/coupons.json
# (OK en dev local, PAS EN PROD car le filesystem Netlify n'est pas persistant)
